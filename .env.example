# Copy this file to `.env` and fill in your values.
# Real environment variables take precedence over entries here.

# Required: any OpenAI-compatible API key.
OPENAI_API_KEY=sk-...

# Required: endpoint root — DeepSeek, Moonshot, OpenRouter, vLLM, Ollama, ...
OPENAI_BASE_URL=https://api.deepseek.com

# Required: model id interpreted by the selected provider.
MODEL_NAME=deepseek-v4-flash

# Optional: web UI port (default 3080).
# DEMO_PORT=3080
