{
  "name": "abyss-harness",
  "version": "0.2.0",
  "description": "A miniature agent harness built on Cordis — every capability is a plugin; the framework layer is vendored under vendor/",
  "type": "module",
  "scripts": {
    "dev": "node --expose-internals --import tsx apps/cli/src/main.mjs",
    "dev:web": "pnpm --filter @abyss-harness-web-frontend run watch",
    "build:web": "pnpm --filter @abyss-harness-web-frontend run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.vendor.json && tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json"
  },
  "packageManager": "pnpm@10.28.1",
  "devDependencies": {
    "@abyss-harness/agent-loop": "workspace:^",
    "@abyss-harness/app-boot": "workspace:^",
    "@abyss-harness/approval": "workspace:^",
    "@abyss-harness/approval-policy": "workspace:^",
    "@abyss-harness/base": "workspace:",
    "@abyss-harness/compaction": "workspace:^",
    "@abyss-harness/llm-retry": "workspace:^",
    "@abyss-harness/cordis": "workspace:^",
    "@abyss-harness/cordis-plugin-group": "workspace:^",
    "@abyss-harness/cordis-plugin-hmr": "workspace:^",
    "@abyss-harness/cordis-plugin-include": "workspace:^",
    "@abyss-harness/cordis-plugin-loader": "workspace:^",
    "@abyss-harness/cordis-plugin-logger-console": "workspace:^",
    "@abyss-harness/cordis-plugin-timer": "workspace:^",
    "@abyss-harness/cosmokit": "workspace:*",
    "@abyss-harness/frontend-static": "workspace:^",
    "@abyss-harness/llm": "workspace:^",
    "@abyss-harness/llm-openai": "workspace:^",
    "@abyss-harness/sandbox": "workspace:^",
    "@abyss-harness/sandbox-policy": "workspace:^",
    "@abyss-harness/schemastery": "workspace:*",
    "@abyss-harness/session": "workspace:^",
    "@abyss-harness/session-persistence-jsonl": "workspace:^",
    "@abyss-harness/system-prompt": "workspace:^",
    "@abyss-harness/token-meter": "workspace:^",
    "@abyss-harness/tool-ask-user": "workspace:^",
    "@abyss-harness/tool-bash": "workspace:^",
    "@abyss-harness/tool-fs-search": "workspace:^",
    "@abyss-harness/tool-observer": "workspace:^",
    "@abyss-harness/tool-read-file": "workspace:^",
    "@abyss-harness/tool-result-limiter": "workspace:^",
    "@abyss-harness/tool-str-replace-editor": "workspace:^",
    "@abyss-harness/tool-write-file": "workspace:^",
    "@abyss-harness/tools": "workspace:^",
    "@abyss-harness/web-api": "workspace:^",
    "@abyss-harness/webserver": "workspace:^",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
