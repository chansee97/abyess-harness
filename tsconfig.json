{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/**/src/**/*.ts",
    "packages/**/tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    // Browser-side code typechecks under apps/web (DOM lib, react); the host
    // graph has no DOM types.
    "packages/client"
  ],
  "compilerOptions": {
    // All remaining strictness trips originate in vendor sources reached
    // through paths (audited under tsconfig.vendor.json's relaxed flags).
    // A single-project demo inherits that leniency here; harness avoids it
    // with per-package project references, which a demo this size skips.
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictFunctionTypes": false,
    "noUncheckedIndexedAccess": false
  }
}
